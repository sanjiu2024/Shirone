---
import AccentBar from "@components/atoms/display/AccentBar.svelte";
import IconButton from "@components/atoms/action/IconButton.svelte";
import Card from "@components/atoms/display/Card.svelte";
import Markdown from "@components/content/Markdown.astro";
import ImageWrapper from "@components/molecules/ImageWrapper.astro";
import LastUpdatedNotice from "@components/molecules/LastUpdatedNotice.astro";
import License from "@components/molecules/License.astro";
import PostMetadata from "@components/molecules/PostMeta.astro";
import Pagination from "@components/molecules/Pagination.astro";
import ArticleDiscovery from "@components/organisms/ArticleDiscovery.astro";
import ArticleShare from "@components/organisms/ArticleShare.svelte";
import CommentSection from "@components/organisms/comment/CommentSection.astro";
import UmamiStats from "@components/organisms/UmamiStats.astro";
import PostPage from "@components/organisms/PostPage.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { resolveAsset } from "@utils/asset-utils";
import { formatDateToYYYYMMDD } from "@utils/date-utils";
import { getPostUrlBySlug } from "@utils/url-utils";
import { Icon } from "astro-icon/components";
import type { Page } from "astro";
import type { CollectionEntry } from "astro:content";
import {
	articleConfig,
	commentConfig,
	licenseConfig,
	postListConfig,
	profileConfig,
	resolveArticleShareOptions,
	resolveCommentOptions,
	resolveLastUpdatedNoticeOptions,
	resolveUmamiOptions,
	siteConfig,
	umamiConfig,
} from "@/config";
import { getPublishedBySlug, listPublishedResilient, renderMarkdownToHtml } from "../lib/posts.ts";
import type { PostRow } from "../lib/posts.ts";

// Universal SSR resolver (single rest route — [...page].astro was removed to
// end the route collision). Post lookup wins over numeric pagination so a
// numeric slug still renders its post; "/" and "/N/" render the list.
const raw = Astro.params.permalink ?? "";

type PostRoute = {
	kind: "post";
	post: PostRow;
	tags: string[];
	published: Date;
	updated: Date;
	description: string;
	canonicalPostUrl: string;
	words: number;
	minutes: number;
	html: string;
	postCommentEnabled: boolean;
	lastUpdatedNotice: ReturnType<typeof resolveLastUpdatedNoticeOptions>;
	shareOptions: ReturnType<typeof resolveArticleShareOptions>;
	umamiEnabled: boolean;
	authorAvatarUrl: string;
	jsonLd: Record<string, unknown>;
};

type ListRoute = { kind: "list"; page: Page; len: number };

let route: PostRoute | ListRoute | { kind: "missing" };

async function buildListRoute(pageNum: number): Promise<ListRoute> {
	const currentPage = Number.isFinite(pageNum) && pageNum > 0 ? Math.floor(pageNum) : 1;
	const pageSize = postListConfig.pageSize;
	// DB first, file fallback inside (local dev without MySQL / DB outage).
	const { posts, total } = await listPublishedResilient(currentPage, pageSize);
	const lastPage = Math.max(1, Math.ceil(total / pageSize));
	const entries = posts.map(
			(post) =>
				({
					id: post.slug,
					slug: post.slug,
					collection: "posts",
					data: {
						title: post.title,
						description: post.description ?? post.title,
						tags: post.tags ?? [],
						category: post.category,
						published: new Date(post.created_at),
						updated: new Date(post.updated_at),
						pinned: Boolean(post.pinned),
						image: post.cover ?? undefined,
						draft: false,
					},
			}) as unknown as CollectionEntry<"posts">,
	);
	const page: Page = {
		data: entries,
		start: (currentPage - 1) * pageSize,
		end: (currentPage - 1) * pageSize + entries.length,
		total,
		currentPage,
		size: pageSize,
		lastPage,
		url: {
			current: currentPage === 1 ? "/" : `/${currentPage}/`,
			prev:
				currentPage > 1
					? currentPage - 1 === 1
						? "/"
						: `/${currentPage - 1}/`
					: undefined,
			next: currentPage < lastPage ? `/${currentPage + 1}/` : undefined,
			first: "/",
			last: lastPage === 1 ? "/" : `/${lastPage}/`,
		},
	};
	return { kind: "list", page, len: entries.length };
}

if (raw === "") {
	route = await buildListRoute(1);
} else if (raw.includes("/")) {
	route = { kind: "missing" };
} else {
	const post = await getPublishedBySlug(raw);
	if (post) {
		const tags = post.tags ?? [];
		const published = new Date(post.created_at);
		const updated = new Date(post.updated_at);
		const description = post.description ?? post.title;
		const canonicalPostUrl = getPostUrlBySlug(post.slug);
		const words = post.content_md.length;
		const minutes = Math.max(1, Math.ceil(words / 400));
		const html = post.html_cache ?? (await renderMarkdownToHtml(post.content_md));
		const postCommentEnabled = Boolean(resolveCommentOptions(commentConfig));
		const lastUpdatedNotice = resolveLastUpdatedNoticeOptions(articleConfig);
		const shareOptions = resolveArticleShareOptions(articleConfig);
		const umamiEnabled = resolveUmamiOptions(umamiConfig) !== null;
		const authorAvatarUrl = shareOptions ? await resolveAsset(profileConfig.avatar ?? "") : "";
		route = {
			kind: "post",
			post,
			tags,
			published,
			updated,
			description,
			canonicalPostUrl,
			words,
			minutes,
			html,
			postCommentEnabled,
			lastUpdatedNotice,
			shareOptions,
			umamiEnabled,
			authorAvatarUrl,
			jsonLd: {
				"@context": "https://schema.org",
				"@type": "BlogPosting",
				headline: post.title,
				description,
				keywords: tags,
				author: { "@type": "Person", name: profileConfig.name, url: Astro.site },
				datePublished: published.toISOString(),
				dateModified: updated.toISOString(),
				inLanguage: siteConfig.lang.replace("_", "-"),
			},
		};
	} else if (/^\d+$/.test(raw)) {
		route = await buildListRoute(Number(raw));
	} else {
		route = { kind: "missing" };
	}
}

if (route.kind === "missing") return new Response("Not Found", { status: 404 });
---

{route.kind === "post" ? (
<MainGridLayout banner={route.post.cover ?? undefined} title={route.post.title} description={route.description} bannerDate={formatDateToYYYYMMDD(route.published)} lang={siteConfig.lang} setOGTypeArticle={true} headings={[]} postCategory={route.post.category || undefined} page="post" hasComments={route.postCommentEnabled}>
    <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(route.jsonLd)}></script>
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative mb-4">
		<Card color="var(--card-bg)" radius="l" class="post-card z-10 px-6 md:px-9 pt-6 pb-4 relative w-full">
			<!-- word count and reading time -->
			<div class="flex flex-row text-[var(--on-surface-variant)] gap-5 mb-3 transition onload-animation">
				<div class="flex flex-row items-center">
					<div class="transition h-6 w-6 rounded-md bg-[var(--surface-container-high)] text-[var(--on-surface-variant)] flex items-center justify-center mr-2">
						<Icon name="material-symbols:notes-rounded"></Icon>
					</div>
					<div class="text-sm">{route.words} {" " + i18n(route.words === 1 ? I18nKey.wordCount : I18nKey.wordsCount)}</div>
				</div>
				<div class="flex flex-row items-center">
					<div class="transition h-6 w-6 rounded-md bg-[var(--surface-container-high)] text-[var(--on-surface-variant)] flex items-center justify-center mr-2">
						<Icon name="material-symbols:schedule-outline-rounded"></Icon>
					</div>
					<div class="text-sm">{route.minutes} {" " + i18n(route.minutes === 1 ? I18nKey.minuteCount : I18nKey.minutesCount)}</div>
				</div>
				{route.umamiEnabled && (
					<div class="flex flex-row items-center">
						<UmamiStats variant="meta" path={route.canonicalPostUrl} />
					</div>
				)}
			</div>

			<!-- title -->
			<div class="relative onload-animation">
				<div
					data-pagefind-body data-pagefind-weight="10" data-pagefind-meta="title"
					class="transition w-full block font-bold mb-3
					text-3xl md:text-[2.25rem]/[2.75rem]
					text-[var(--on-surface)]
					flex items-center gap-3"
				>
					<AccentBar size="large" />
					<div class="inline-block">
						{route.post.title}
					</div>
					<IconButton
						id="copy-post-link"
						label={i18n(I18nKey.copyLink)}
						class="ml-auto shrink-0"
					>
						<Icon name="material-symbols:link-rounded" class="text-[1.25rem]" />
					</IconButton>
				</div>
			</div>

			<!-- metadata -->
			<div class="onload-animation">
				<PostMetadata
					class="mb-5"
					published={route.published}
					updated={route.updated}
					tags={route.tags}
					category={route.post.category}
				></PostMetadata>
				{!route.post.cover && <div class="border-[var(--line-divider)] border-dashed border-b-[1px] mb-5"></div>}
			</div>

            <!-- always show cover as long as it has one -->

			{route.post.cover &&
				<ImageWrapper
					id="post-cover"
					src={route.post.cover}
					class="mb-8 rounded-xl banner-container onload-animation"
					loading="eager"
					fetchPriority="high"
					widths={[360, 720, 1080, 1440]}
					sizes="(min-width: 1280px) 720px, (min-width: 768px) calc(100vw - 22rem), calc(100vw - 3.5rem)"
					formats={["avif", "webp"]}
					quality={65}
				/>
			}

            <Markdown class="mb-6 onload-animation">
                <Fragment set:html={route.html} />
            </Markdown>

			{licenseConfig.enable && <License title={route.post.title} slug={route.post.slug} pubDate={route.published} class="mb-6 rounded-xl license-container onload-animation"></License>}

			{route.shareOptions && (
				<ArticleShare
					client:visible
					options={route.shareOptions}
					title={route.post.title}
					description={route.description}
					author={profileConfig.name}
					published={formatDateToYYYYMMDD(route.published)}
					siteTitle={siteConfig.title}
					postPath={route.canonicalPostUrl}
					coverSelector={route.post.cover ? "#post-cover img" : undefined}
					avatarUrl={route.authorAvatarUrl}
					class="mb-6 rounded-xl onload-animation"
				/>
			)}

			<ArticleDiscovery
				related={[]}
				random={[]}
				class="onload-animation"
			/>

		</Card>
    </div>

    <CommentSection
        context={{
            key: `post:${route.post.slug}`,
            path: route.canonicalPostUrl,
            title: route.post.title,
            language: siteConfig.lang,
        }}
        postCommentEnabled={route.postCommentEnabled}
        class="onload-animation"
    />

    {route.lastUpdatedNotice && (
        <LastUpdatedNotice
            date={route.updated}
            minimumAgeDays={route.lastUpdatedNotice.minimumAgeDays}
            class="mb-4 onload-animation"
        />
    )}

    <div class="flex flex-col md:flex-row justify-between mb-4 gap-4 overflow-hidden w-full">
        <div class="w-full"></div>
        <div class="w-full"></div>
    </div>

</MainGridLayout>
) : (
<MainGridLayout page="home">
    <PostPage page={route.page}></PostPage>
    <Pagination class="mx-auto onload-animation" page={route.page} style={`animation-delay: calc(var(--content-delay) + ${(route.len)*50}ms)`}></Pagination>
</MainGridLayout>
)}

<style is:global lang="stylus">
	/* ???/????? hover ????????????????????
	   reduced-motion ??? motion-reduced ???????????? */
	.post-nav
		.post-nav__arrow
			transition: transform var(--m3e-duration-medium) var(--m3e-easing-emphasized-decelerate)

		.post-nav__title
			transition: color var(--m3e-duration-short) var(--m3e-easing-standard)

		&:hover .post-nav__title
			color: var(--primary)

		&--prev:hover .post-nav__arrow
			transform: translateX(-0.25rem)

		&--next:hover .post-nav__arrow
			transform: translateX(0.25rem)
</style>
