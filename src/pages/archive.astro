---
import ArchivePanel from "@components/organisms/ArchivePanel.svelte";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { listPublished } from "../lib/posts.ts";
import { getPostUrlBySlug } from "../utils/url-utils";

const { posts: publishedPosts } = await listPublished(1, 10000);
const sortedPostsList = publishedPosts.map((post) => ({
	slug: post.slug,
	url: getPostUrlBySlug(post.slug),
	data: {
		title: post.title,
		tags: post.tags ?? [],
		category: post.category,
		published: new Date(post.created_at),
	},
}));
const archiveSummary = `${sortedPostsList.length} ${i18n(I18nKey.postsCount)}`;
---

<MainGridLayout title={i18n(I18nKey.archive)} description={archiveSummary} page="archive">
    <ArchivePanel sortedPosts={sortedPostsList} client:visible></ArchivePanel>
</MainGridLayout>

