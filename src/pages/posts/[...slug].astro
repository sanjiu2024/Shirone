---
// Canonical post URLs are /posts/<slug>/ (see getPostUrlBySlug). Posts live
// in MySQL now, and the single renderer is the universal [...permalink]
// resolver — rewrite internally so no URL changes and no markup duplication.
const slug = Astro.params.slug ?? "";
if (!slug || slug.includes("/")) return new Response("Not Found", { status: 404 });
return Astro.rewrite(`/${slug}/`);
---
