---
import AccentBar from "@components/atoms/display/AccentBar.svelte";
import Card from "@components/atoms/display/Card.svelte";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import { commentConfig, resolveCommentOptions } from "@/config";
import type { CommentContext } from "@/types/commentConfig";

interface Props {
	context: CommentContext;
	postCommentEnabled?: boolean;
	postId?: number;
	class?: string;
}

const {
	context,
	postCommentEnabled = true,
	postId,
	class: className,
} = Astro.props;
const options = resolveCommentOptions(commentConfig);

if (!options || !postCommentEnabled) {
	return null;
}

const isGithubDb = options.provider === "github-db";

// Resolve the numeric post id server-side without touching the caller:
// an explicit postId prop wins, otherwise derive the slug from the
// stable `post:<slug>` context key. Only queried for github-db so the
// disabled/twikoo paths keep zero extra cost.
let githubDbPostId: number | null = postId ?? null;
let githubDbSlug = "";
if (isGithubDb) {
	if (context.key.startsWith("post:")) {
		githubDbSlug = context.key.slice("post:".length);
	}
	if (githubDbPostId === null && githubDbSlug) {
		try {
			const { getPublishedBySlug } = await import("../../../lib/posts.ts");
			githubDbPostId = (await getPublishedBySlug(githubDbSlug))?.id ?? null;
		} catch {
			githubDbPostId = null;
		}
	}
	if (githubDbPostId === null) {
		return null;
	}
}

const GithubLoginButton =
	isGithubDb && githubDbPostId !== null
		? (await import("@components/organisms/auth/GithubLoginButton.svelte"))
				.default
		: null;
const CommentIsland =
	isGithubDb && githubDbPostId !== null
		? (await import("@components/organisms/comment/CommentIsland.svelte"))
				.default
		: null;

const Twikoo =
	options.provider === "twikoo"
		? (await import("@components/organisms/comment/Twikoo.astro")).default
		: null;
---

<section
	id="comments"
	aria-labelledby="comments-title"
	class:list={["comment-section w-full mb-4", className]}
	data-comment-section
>
	<Card color="var(--card-bg)" radius="l" class="p-6 md:p-8 w-full relative">
		<div class="flex items-center gap-3 mb-6 relative">
			<AccentBar size="small" class="!inline-block" />
			<h2 id="comments-title" class="text-xl md:text-2xl font-bold text-[var(--on-surface)] m-0">
				{i18n(I18nKey.comments)}
			</h2>
		</div>

		{options.provider === "twikoo" && Twikoo && (
			<Twikoo
				context={context}
				config={options.twikoo}
				lazy={options.lazy}
			/>
		)}

		{options.provider === "github-db" && GithubLoginButton && CommentIsland && githubDbPostId !== null && (
			<>
				<GithubLoginButton client:load />
				<CommentIsland
					client:visible
					postId={githubDbPostId}
					slug={githubDbSlug}
					enabled={true}
				/>
			</>
		)}
	</Card>
</section>
